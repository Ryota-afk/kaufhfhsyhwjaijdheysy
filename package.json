{
  "name": "champions-sensyutsu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ポケモンチャンピオンズ（シングル）の選出・対戦判断サイト",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "showdown:setup": "bash tools/showdown/setup.sh",
    "gen:data": "tsx tools/gen-data.ts",
    "seed:check": "tsx tools/seed-check.ts",
    "bench": "tsx tools/bench.ts",
    "compare": "tsx tools/compare/run.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
